# Copy to .env and fill in. .env is git-ignored.

# MongoDB connection string (Atlas or local). Required.
MONGOURL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Long random string used to sign login cookies. Required.
# Generate one: node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=

# Optional
# ALLOW_SIGNUP=false         # refuse new accounts (set after your own account exists)
# MONGO_DB=billing-pdf       # database name (default: billing-pdf)
# PORT=4000                  # API / production server port (default: 4000)
# NODE_ENV=production        # serve the built app from dist/ and use secure cookies
# COOKIE_SECURE=false        # override the secure-cookie default (e.g. production over plain http)
# TRUST_PROXY=1              # set when running behind a reverse proxy (Render, Nginx, ...)
